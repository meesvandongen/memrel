{
  "name": "memrel-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run @mvd/memrel-playground#dev",
    "check": "vp check",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "bench": "vp run -r bench",
    "ready": "vp check && vp run -r test && vp run -r build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "vp run --filter @mvd/memrel build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.28.0"
}
